        {
          "name": "Login - Com cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Converte a resposta recebida para JSON",
                  "const response = pm.response.json();",
                  "// Verifica se o token existe na resposta",
                  "if (response.token) {",
                  "    // Salva o token na variável de ambiente/coleção com o nome \"jwt_token\"",
                  "    pm.environment.set(\"JWT_TOKEN\", response.token);",
                  "    console.log(\"Token JWT salvo com sucesso!\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
